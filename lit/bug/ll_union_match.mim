// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p ll %s
plugin core;
plugin mem;
plugin option;

lam mk (n: Nat)@ff: option.Opt I32 =
    core.select (core.ncmp.e (n, 0), option.some 7I32, mk (core.nat.sub (n, 1)));

extern fun f (mm: mem.M 0, n: Nat): [mem.M 0, I32] =
    match mk n with
        | _: [] => return (mm, 0I32)
        | x: I32 => return (mm, x);
